@startuml casos_de_uso_general
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

' Actores primarios
actor "Visitante" as V
actor "Cliente\n(consumidor final B2C)" as C
actor "Peluquero verificado\n(B2B)" as P
actor "Dueña\n(administradora)" as D
actor "Vendedor/a" as VEN
actor "Bodeguero/a" as BOD
actor "Administrador/a" as ADM


' Generalizaciones: cada actor hereda lo del anterior
P --|> C
D --|> VEN

' Actores secundarios
actor "Mercado Pago" as MP <<sistema externo>>
actor "Servicio de envíos" as ENV <<sistema externo>>
actor "Servicio de correo" as MAIL <<sistema externo>>
actor "Servicio de IA" as IA <<sistema externo>>
actor "Servicio de\nfacturación electrónica" as FACT <<sistema externo>>

rectangle "Plataforma e-commerce Cabello Perfecto" {

  package "Acceso y cuenta" {
    usecase "UC01 Registrarse" as UC01
    usecase "UC02 Confirmar\ncorreo electrónico" as UC02
    usecase "UC03 Iniciar sesión" as UC03
    usecase "UC04 Cerrar sesión" as UC04
    usecase "UC05 Cerrar sesión en\ntodos los dispositivos" as UC05
    usecase "UC06 Recuperar contraseña" as UC06
  }

  package "Catálogo y compra" {
    usecase "UC07 Explorar catálogo" as UC07
    usecase "UC08 Gestionar carrito" as UC08
    usecase "UC09 Realizar compra" as UC09
    usecase "UC10 Elegir método\nde entrega" as UC10
    usecase "UC11 Cotizar despacho\na domicilio" as UC11
    usecase "UC12 Pagar pedido" as UC12
    usecase "UC13 Consultar estado\nde pedido" as UC13
    usecase "UC14 Cancelar pedido" as UC14
  }

  package "Facturación" {
    usecase "UC25 Elegir tipo\nde documento" as UC25
    usecase "UC26 Gestionar datos\nde facturación" as UC26
    usecase "UC27 Descargar documento\ntributario" as UC27
  }

  package "Verificación de peluqueros" {
    usecase "UC15 Solicitar verificación\nde cuenta profesional" as UC15
    usecase "UC16 Adjuntar antecedentes\nprofesionales" as UC16
    usecase "UC17 Resolver solicitud\nde verificación" as UC17
  }

  package "Marketing" {
    usecase "UC28 Suscribirse a\nofertas por correo" as UC28
    usecase "UC29 Gestionar preferencias\nde marketing" as UC29
  }

  package "Administración de la tienda" {
    usecase "UC18 Gestionar productos" as UC18
    usecase "UC19 Generar descripción\ncon IA" as UC19
    usecase "UC20 Gestionar categorías" as UC20
    usecase "UC21 Configurar precios\npor tipo de cliente" as UC21
    usecase "UC23 Gestionar roles\ny permisos" as UC23
    usecase "UC24 Gestionar personal\nde tienda" as UC24
  }

  package "Bodega" {
    usecase "UC28 Gestionar productos" as UC28
    usecase "UC29 Gestionar stock" as UC29
    usecase "UC30 Gestionar envios" as UC30
    usecase "UC31 Actualizar estado pedido" as UC31
  }

  package "Inventario" {
    usecase "UC31 Consultar stock" as UC32
    usecase "UC32 Actualizar stock" as UC33
    usecase "UC33 Mermar productos" as UC34
  }
}

'Actores primarios -> casos de uso
V --> UC01
V --> UC07


C --> UC03
C --> UC04
C --> UC06
C --> UC07
C --> UC08
C --> UC09
C --> UC13
C --> UC14
C --> UC15
C --> UC26
C --> UC29

VEN --> UC03
VEN --> UC04
VEN --> UC06
VEN --> UC14
VEN --> UC17

ADM --> UC18
ADM --> UC20
ADM --> UC21
ADM --> UC32
ADM --> UC33
ADM --> UC34

D --> UC23
D --> UC24

BOD --> UC28
BOD --> UC29  
BOD --> UC30
BOD --> UC31
BOD --> UC32
BOD --> UC33



' Relaciones entre casos de uso
UC01 ..> UC02 : <<include>>
UC09 ..> UC10 : <<include>>
UC09 ..> UC12 : <<include>>
UC09 ..> UC25 : <<include>>
UC15 ..> UC16 : <<include>>
UC05 .up.> UC04 : <<extend>>
UC11 .up.> UC10 : <<extend>>
UC19 .up.> UC18 : <<extend>>
UC27 .up.> UC13 : <<extend>>
UC33 ..> UC32 : <<extend>>

' Actores secundarios 
UC12 --> MP
UC12 --> FACT
UC11 --> ENV
UC01 --> MAIL
UC06 --> MAIL
UC17 --> MAIL
UC19 --> IA
UC31 --> MAIL

@enduml
